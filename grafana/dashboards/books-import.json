{
  "title": "Books Import",
  "uid": "books-import",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Messages Processed (total)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 4 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "books_import_listener_seconds_count",
          "legendFormat": "total"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Throughput (messages / sec)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 6 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(books_import_listener_seconds_count[1m])",
          "legendFormat": "msg/s"
        }
      ]
    },
    {
      "id": 3,
      "title": "Processing Time (max per scrape)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 10, "w": 24, "h": 6 },
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "books_import_listener_seconds_max",
          "legendFormat": "max"
        }
      ]
    },
    {
      "id": 4,
      "title": "Avg Processing Time per Message",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 6 },
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(books_import_listener_seconds_sum[1m]) / rate(books_import_listener_seconds_count[1m])",
          "legendFormat": "avg"
        }
      ]
    }
  ]
}
